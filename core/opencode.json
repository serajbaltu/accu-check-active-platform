{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "lsusb*": "allow",
      "dmesg*": "allow",
      "ls -l /dev/bus/usb/*": "allow",
      "ls -l /sys/bus/usb/*": "allow",
      "cat /sys/bus/usb/*": "allow",
      "cat /sys/kernel/debug/usb/*": "allow",
      "ls /sys/kernel/debug/usb/*": "allow",
      "getfacl*": "allow",
      "id": "allow",
      "whoami": "allow",
      "uname -a": "allow",
      "python3*": "allow",
      "python -m src*": "allow",
      "pytest*": "allow",
      "pip install*": "allow",
      "pip3 install*": "allow",
      "pip list*": "allow",
      "pip3 list*": "allow",
      "git clone*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "make*": "allow",
      "tshark*": "allow",
      "dumpcap*": "allow",
      "tcpdump*": "ask",
      "sudo modprobe*": "allow",
      "sudo tshark*": "allow",
      "sudo dumpcap*": "allow",
      "sudo lsusb*": "allow",
      "sudo udevadm*": "allow",
      "sudo tee /etc/udev/rules.d/*": "allow",
      "sudo cp /etc/udev/rules.d/*": "allow",
      "sudo chmod*": "allow",
      "sudo chown*": "allow",
      "sudo rm /etc/udev/rules.d/99-accuchek.rules": "allow",
      "sudo *": "ask",
      "rm -rf /": "deny",
      "rm -rf *": "deny",
      "rm *": "ask",
      "mkfs*": "deny",
      "dd *": "ask",
      "shutdown*": "deny",
      "reboot*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "task": "allow"
  },
  "instructions": ["AGENTS.md"]
}
